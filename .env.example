PORT=3000
MONGO_URI=mongodb://localhost:27017/nest-mongo-user
# Secrets de signature des jetons, un par usage, jamais recopiés d'un exemple.
# 64 caractères hexadécimaux exigés : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Le service refuse de démarrer sans eux. Mêmes valeurs dans le gateway et le bot.
JWT_USER_SECRET=
JWT_SERVICE_SECRET=
JWT_EXPIRES_IN=3600s
CORS_ORIGINS=https://app.mondomaine.com,https://admin.mondomaine.com
WEBHOOK_SYNC_TARGETS=http://localhost:3000/internal/sync,http://api.dashboard.com/v1/update
LOG_LEVELS=error,warn